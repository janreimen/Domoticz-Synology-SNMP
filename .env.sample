# Domoticz-Synology-SNMP polling schedule and transport tuning
# Copy this file to .env in the plugin root directory.
# All values are seconds unless noted. Collector intervals: 10..86400 (10 seconds to 24 hours).
# .env is local configuration and should not be committed. Process environment
# variables with the same names override values in .env.
# Format: KEY=value, one per line; "export KEY=value", quotes and a trailing "# comment" are accepted.
# A key the plugin does not know (a typo) is reported in the Domoticz log and ignored.
# The plugin polls every <shortest interval of the collectors in use> seconds, and a collector runs in the first poll
# at or after its own interval: with 30 s as the shortest interval, a collector set to 45 s runs every 60 s.
# SNMP credentials are never read from this file: they stay in the Domoticz hardware settings.
#
# Each setting schedules one collector family. Some collectors intentionally
# contain several related readings; see README.md for the exact sensor mapping.

# System status, fans, thermal status, NAS temperature, DSM info/update state
SYSTEM_INTERVAL=60

# CPU, memory, swap, load averages and uptime
RESOURCES_INTERVAL=60

# Physical disk health, temperatures, remaining life and bad-sector counters
DISKS_INTERVAL=300

# RAID / storage-pool status
RAID_INTERVAL=300

# Volume usage and free capacity
VOLUMES_INTERVAL=600

# Network interface status and traffic rates
NETWORK_INTERVAL=60

# UPS status, charge, load, runtime and identifying information
UPS_INTERVAL=60

# Expansion-unit and redundant-power status
EXPANSION_UNITS_INTERVAL=300

# Physical disk load and read/write throughput
DISK_IO_INTERVAL=60

# SMART health and detailed drive statistics
SMART_INTERVAL=3600

# Connected users per supported service (SMB/CIFS, NFS, FTP, SSH, etc.)
SERVICES_INTERVAL=300

# SSD cache read/write hit rates
SSD_CACHE_INTERVAL=60

# GPU and GPU-memory utilization (where supported)
GPU_INTERVAL=60

# --- Transport and housekeeping -----------------------------------------------------

# Seconds to wait for one SNMP answer (1..60). A request is tried SNMP_RETRIES + 1 times.
SNMP_TIMEOUT=5

# Retries per SNMP request after a timeout (0..5)
SNMP_RETRIES=1

# How often the hardware (drives, volumes, network ports, UPS, ...) is detected again (60..86400)
DISCOVERY_INTERVAL=3600

# Unchanged values are written to Domoticz again this often, so "last seen" stays current (30..86400)
REFRESH_INTERVAL=300

# --- A NAS that is switched off on a schedule -----------------------------------------

# When the NAS is meant to be off, as a week: one line per weekday, each with none to six slots HH:MM-HH:MM separated by
# commas, local time of the Domoticz host. In a slot (and in the grace period after it, below) a NAS that does not
# answer is not an error: nothing is logged as an error, Plugin Health is grey, the devices keep their last values and
# polling slows down to one probe every 5 minutes. Start a slot a minute or two before the NAS shuts down.
#
# A slot belongs to the day on which it starts. When its end is not later than its start it runs into the next day:
# EXPECTED_OFFLINE_MON=23:30-12:00 is Monday 23:30 to Tuesday 12:00. Slots that touch or overlap are one off period.
# Slots of one day must not overlap; at most 6 per day. An empty line (or "none") means no off period starts that day.
# Leave everything commented out for a NAS that runs all the time.

# The line of every weekday that has none of its own below. A NAS that is off every night:
#EXPECTED_OFFLINE=23:30-12:00

# One line per weekday (these replace EXPECTED_OFFLINE for that day), for example:
#EXPECTED_OFFLINE_MON=23:30-12:00
#EXPECTED_OFFLINE_TUE=23:30-12:00
#EXPECTED_OFFLINE_WED=23:30-12:00
#EXPECTED_OFFLINE_THU=23:30-12:00
#EXPECTED_OFFLINE_FRI=23:30-12:00
#EXPECTED_OFFLINE_SAT=13:00-15:00,23:30-12:00
#EXPECTED_OFFLINE_SUN=

# Seconds after the end of each off period in which silence is still expected, so that the NAS can boot and start its
# SNMP service (0..86400). An error is logged only if the NAS is still silent after that.
#EXPECTED_OFFLINE_GRACE=900
